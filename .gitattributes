# Auto detect text files and perform LF normalization
* text=auto

# Source code files - force LF
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.toml text eol=lf

# Makefiles need tabs
Makefile text eol=lf

# Binary files - don't touch
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.zip binary
*.pyc binary
